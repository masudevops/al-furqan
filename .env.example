# Al-Furqan environment template
# Copy to .env.local for local development. Never commit real credentials.

# Server-only provider credentials. These MUST NOT use the VITE_ prefix.
HADITH_API_KEY=
ISLAMHOUSE_API_KEY=

# Optional comma-separated browser origins allowed to call a separately hosted
# provider gateway. Same-origin requests and native mobile clients do not need it.
PROVIDER_ALLOWED_ORIGINS=

# Public, non-secret URL prefix used by web/PWA clients. Keep the same-origin
# default for Vercel, or point it at a separately deployed provider gateway.
VITE_PROVIDER_API_BASE_URL=/api/providers

# Mushaf View Feature Flag
# Set to 'true' to enable Mushaf view, 'false' to disable
VITE_ENABLE_MUSHAF_VIEW=true

# Other feature flags (for future use)
VITE_ENABLE_AUDIO_PLAYER=true
VITE_ENABLE_BOOKMARKS=true
VITE_ENABLE_TAFSEER=true
VITE_ENABLE_ISLAMIC_LIBRARY=true
VITE_ENABLE_PRAYER_TIMES=true
VITE_ENABLE_HISNUL_MUSLIM=true

# Development flags
VITE_ENABLE_DEBUG_MODE=false
VITE_ENABLE_BETA_FEATURES=false
