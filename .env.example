# Required
PORT=3000
APP_BASE_URL=http://localhost:3000
CLIENT_ID=your_client_id
CLIENT_SECRET=your_client_secret
SESSION_SECRET=replace_with_a_long_random_secret

# Optional runtime behavior
# Set only scopes approved for this client. Search is a separate app-token permission.
SCOPES=openid offline_access bookmark note collection goal preference
TRANSLATION_IDS=131
DEFAULT_READER_CHAPTER=1

# Optional production session store
# REDIS_URL=redis://localhost:6379

# Optional UmmahAPI settings. Hadith is enabled unless explicitly set false.
HADITH_ENABLED=true
# UMMAH_API_KEY=
# UMMAH_API_URL=https://ummahapi.com

# Optional public feature flags. A change requires a new build/deployment.
NEXT_PUBLIC_FEATURE_SALAH_TIMES=true
NEXT_PUBLIC_FEATURE_DUA=true
NEXT_PUBLIC_FEATURE_QIBLA=false
NEXT_PUBLIC_FEATURE_MASJID_FINDER=true

# Optional ownership verification tokens from Google Search Console and Bing Webmaster Tools.
# Add only the token value, not the full HTML meta tag.
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=


# Optional service overrides (leave empty for built-in production defaults)
# Use only a complete, matching pre-live configuration when testing pre-live.
# Never combine production credentials/sessions with a pre-live OAuth host.
# OAUTH2_BASE_URL=https://oauth2.quran.foundation
# AUTH_BASE_URL=https://apis.quran.foundation
# CONTENT_BASE_URL=https://apis.quran.foundation
# SEARCH_BASE_URL=https://apis.quran.foundation
# QURAN_REFLECT_BASE_URL=https://apis.quran.foundation
# GATEWAY_URL=https://apis.quran.foundation
# TOKEN_HOST=https://oauth2.quran.foundation
